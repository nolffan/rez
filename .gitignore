# Disc images and their zips (fetched by ./fetch-isos.sh; isos/SHA256SUMS is tracked)
/isos/*.zip
/isos/*.iso
/isos/*.part
/isos/ps2/
/isos/mac/
/isos/sdk/
# Installed games, SDKs and dev tools (./install-games.sh,
# ./install-devtools.sh) under installed/; games and sdk are links into it
# for the paths used before. And scratch.
/installed/
/games
/sdk
/.work/
# Built from tools/blast's source
/tools/blast/blast
# Built from tools/unshield's sources
/tools/unshield/unshield
/tools/unshield/unshield-deobfuscate
__pycache__/
# Demos, patches, map packs and dev tools: only their archives' chunks are tracked
# (tools/pack-artifacts.sh); ./assemble-artifacts.sh rebuilds the archives
# in artifacts/, of which only SHA256SUMS is tracked.
/demos/*
/patches/*
/mappacks/*
/devtools/*
!/demos/*.tar.xz.c[0-9][0-9][0-9]
!/patches/*.tar.xz.c[0-9][0-9][0-9]
!/mappacks/*.tar.xz.c[0-9][0-9][0-9]
!/devtools/*.tar.xz.c[0-9][0-9][0-9]
/artifacts/*
!/artifacts/SHA256SUMS
